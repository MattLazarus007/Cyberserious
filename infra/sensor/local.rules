# Lab rules for our own traffic on lo0, ports 8100 (regulator) and
# 8200 (organisation portal). Written against the fixture that
# scripts/build-fixture-pcap.mjs builds, so every rule here is proven
# to fire in replay before it is committed.

# A form post that carries a password field in the clear. The body
# says pass=, which the JSON login never sends, so this is a settings
# style form, not the login itself.
alert http any any -> any [8100,8200] (msg:"LAB cleartext credential post on an app port"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"pass="; classtype:bad-unknown; sid:9000001; rev:1;)

# Five posts to the login path from one source inside thirty seconds.
# The fifth match raises the alert, which is the burst the lab lockout
# also counts. threshold type threshold fires on the fifth itself, where
# detection_filter only fires once count is passed.
alert http any any -> any 8100 (msg:"LAB rapid login failure burst on 8100"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/v1/login"; threshold: type threshold, track by_src, count 5, seconds 30; classtype:attempted-dos; sid:9000002; rev:1;)

# A syn scan across the app ports. Three syns from one source to
# 8100 or 8200 inside thirty seconds. A browser opening keep-alive
# connections can trip this too, which the runbook states plainly.
# threshold type threshold fires on the third syn itself.
alert tcp any any -> any [8100,8200] (msg:"LAB tcp port probe against app ports"; flags:S; flow:stateless; threshold: type threshold, track by_src, count 3, seconds 30; classtype:attempted-recon; sid:9000003; rev:1;)
