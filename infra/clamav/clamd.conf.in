DatabaseDirectory @REPO@/data/clamav/db
LocalSocket @REPO@/data/clamav/clamd.sock
LocalSocketMode 600
PidFile @REPO@/data/clamav/clamd.pid
LogFile @REPO@/data/clamav/clamd.log
LogFileMaxSize 10M
LogTime yes
Foreground true
MaxThreads 2
MaxScanSize 100M
MaxFileSize 50M
StreamMaxLength 25M
ReadTimeout 60
CommandReadTimeout 30
ScanPE yes
ScanELF yes
ScanOLE2 yes
ScanPDF yes
ScanSWF yes
ScanArchive yes
DetectPUA no
ExitOnOOM yes
