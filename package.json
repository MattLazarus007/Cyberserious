    "dev:org": "node apps/organisation/server/index.ts",
    "worker": "node apps/regulator/server/worker.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
